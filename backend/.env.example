NODE_ENV=production
NODE_VERSION=22
npm_config_build_from_source=true
DATABASE_PATH=/var/data/database.sqlite
CORS_ORIGIN=https://sistema-compras-preview.web.app,https://sistema-compras-preview.firebaseapp.com,http://localhost:5173
ORDEM_COMPRA_EMAIL_PROVIDER=local-fake
PUPPETEER_HEADLESS=new
PUPPETEER_NO_SANDBOX=1
PDF_PROVIDER_STRICT=0

# SMTP real, se for usar envio de OC:
